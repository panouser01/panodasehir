generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  emailVerified     DateTime?
  password          String?
  name              String?
  image             String?
  role              String       @default("USER")
  companyName       String?
  phone             String?
  taxId             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  cityId            String?
  districtId        String?
  accounts          Account[]
  ads               Ad[]
  managedCategories Category[]   @relation("WallManager")
  postits           PostIt[]
  likes             PostItLike[]
  sessions          Session[]
  city              City?        @relation(fields: [cityId], references: [id])
  district          District?    @relation(fields: [districtId], references: [id])
  userGroups        UserGroup[]  @relation("UserToUserGroup")

  @@index([cityId])
  @@index([districtId])
}

model UserGroup {
  id            String     @id @default(cuid())
  name          String     @unique
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  assignedWalls Category[]
  users         User[]     @relation("UserToUserGroup")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id                  String              @id @default(cuid())
  name                String
  description         String?
  parentId            String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  heroBackgroundImage String?
  isHeroTransparent   Boolean?            @default(false)
  heroSubtitle        String?
  heroTitleFont       String?             @default("sans-serif")
  heroTitleColor      String?             @default("#ffffff")
  heroTitleSize       String?             @default("5xl")
  heroSubtitleFont    String?             @default("sans-serif")
  heroSubtitleColor   String?             @default("#ffffff")
  heroSubtitleSize    String?             @default("xl")
  heroGradientFrom    String?             @default("#facc15")
  heroGradientVia     String?             @default("#f472b6")
  heroGradientTo      String?             @default("#a855f7")
  categoryFont        String?             @default("sans-serif")
  categoryColor       String?             @default("#1f2937")
  categoryBgColor     String?             @default("#ffffff")
  ribbonColor         String?             @default("#502bb1")
  postCount           Int                 @default(0)
  userGroupId         String?
  cityId              String?
  districtId          String?
  heroAlignment       String?             @default("left")
  backgroundColor     String?
  backgroundImage     String?
  borderBottomColor   String?
  borderColor         String?
  borderTopColor      String?
  gradientFrom        String?             @default("#facc15")
  gradientTo          String?             @default("#a855f7")
  gradientVia         String?             @default("#f472b6")
  isGradient          Boolean?            @default(false)
  isWallTransparent   Boolean?            @default(false)
  isWallBackgroundRepeat Boolean?         @default(true)
  noBorder            Boolean?            @default(false)
  navMenuBgColor      String?
  navMenuFont         String?
  navMenuFontSize     Int?
  navMenuMainBold     Boolean?
  navMenuTextColor    String?
  siteBackgroundColor String?
  siteBackgroundImage String?
  siteGradientFrom    String?
  siteGradientTo      String?
  siteGradientVia     String?
  siteIsGradient      Boolean?
  contactName         String?
  contactPhone        String?
  contactEmail        String?
  homeCategoryIds     Json?
  postitLimit         Int?                @default(0)

  // Logo Settings
  logoUrl             String?
  logoPosition        String?             @default("top-right") // e.g. "top-right", "top-left", "bottom-right", "bottom-left", "center"
  logoSize            String?             @default("medium") // e.g. "small", "medium", "large"
  useParentLogo       Boolean?            @default(false)

  // Layout / Widget Settings
  useCustomLayout     Boolean?            @default(false)
  customLayout        Json?

  ads                 Ad[]
  city                City?               @relation(fields: [cityId], references: [id])
  district            District?           @relation(fields: [districtId], references: [id])
  parent              Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children            Category[]          @relation("CategoryHierarchy")
  assignedGroup       UserGroup?          @relation(fields: [userGroupId], references: [id])
  wallManagers        User[]              @relation("WallManager")
  postits             PostIt[]
  slider              Slider?
  calendarEntries     WallCalendarEntry[]

  @@unique([name, parentId])
  @@index([parentId], map: "Category_parentId_fkey")
  @@index([userGroupId], map: "Category_userGroupId_fkey")
  @@index([cityId])
  @@index([districtId])
}

model UserRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PostIt {
  id          String        @id @default(cuid())
  userId      String
  categoryId  String
  content     String
  link        String?
  color       PostItColor   @default(YELLOW)
  font        PostItFont    @default(HANDWRITING)
  pushpin     PushpinStyle  @default(RED)
  rotation    Float         @default(0)
  expiresAt   DateTime
  isApproved  Boolean       @default(false)
  isModerated Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  imageUrl    String?
  isPublished Boolean       @default(true)
  views       Int           @default(0)
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  PostItImage PostItImage[]
  likes       PostItLike[]

  @@index([categoryId])
  @@index([userId])
  @@index([expiresAt])
  @@index([isApproved])
  @@index([isPublished])
}

model Ad {
  id         String     @id @default(cuid())
  title      String
  imageUrl   String
  link       String
  position   AdPosition
  categoryId String?
  createdBy  String
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  category   Category?  @relation(fields: [categoryId], references: [id])
  creator    User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([position])
  @@index([isActive])
  @@index([categoryId], map: "Ad_categoryId_fkey")
  @@index([createdBy], map: "Ad_createdBy_fkey")
}

model PostItImage {
  id        String   @id
  url       String
  postItId  String
  createdAt DateTime @default(now())
  PostIt    PostIt   @relation(fields: [postItId], references: [id], onDelete: Cascade)

  @@index([postItId])
}

model Slider {
  id               String    @id @default(cuid())
  categoryId       String?   @unique
  images           Json
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  links            Json?
  backgroundColor  String?   @default("#f8f9fa")
  heroGradientFrom String?   @default("#facc15")
  heroGradientTo   String?   @default("#a855f7")
  heroGradientVia  String?   @default("#f472b6")
  isGradient       Boolean   @default(false)
  isTransparent    Boolean   @default(false)
  backgroundImage  String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model City {
  id         String     @id @default(cuid())
  name       String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  categories Category[]
  districts  District[]
  users      User[]
}

model District {
  id         String     @id @default(cuid())
  name       String
  cityId     String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  categories Category[]
  city       City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  users      User[]

  @@unique([name, cityId])
  @@index([cityId])
}

model SiteSettings {
  id                  String   @id @default("global")
  backgroundColor     String   @default("#cca378")
  backgroundImage     String   @default("https://www.transparenttextures.com/patterns/cork-board.png")
  borderColor         String   @default("#6b4423")
  borderTopColor      String   @default("#8a5a2e")
  borderBottomColor   String   @default("#4a2f18")
  updatedAt           DateTime @updatedAt
  noBorder            Boolean  @default(false)
  heroBackgroundImage String?
  isHeroTransparent   Boolean? @default(false)
  heroGradientFrom    String?  @default("#facc15")
  heroGradientTo      String?  @default("#a855f7")
  heroGradientVia     String?  @default("#f472b6")
  heroSubtitle        String?
  heroSubtitleColor   String?  @default("#ffffff")
  heroSubtitleFont    String?  @default("sans-serif")
  heroSubtitleSize    String?  @default("xl")
  heroTitleColor      String?  @default("#ffffff")
  heroTitleFont       String?  @default("sans-serif")
  heroTitleSize       String?  @default("5xl")
  heroAlignment       String?  @default("left")
  gradientFrom        String?  @default("#facc15")
  gradientTo          String?  @default("#a855f7")
  gradientVia         String?  @default("#f472b6")
  isGradient          Boolean  @default(false)
  siteBackgroundColor String?  @default("#fffbeb")
  siteGradientFrom    String?  @default("#fffbeb")
  siteGradientTo      String?  @default("#fff7ed")
  siteGradientVia     String?  @default("#fefce8")
  siteIsGradient      Boolean  @default(true)
  calendarColor       String?  @default("#dc2626")
  calendarPosition    String?  @default("right")
  calendarShow        Boolean? @default(true)
  calendarSize        String?  @default("medium")
  calendarPopupBackgroundImage String?
  aboutContent        String?  @db.Text
  contactContent      String?  @db.Text
  cookiesContent      String?  @db.Text
  helpContent         String?  @db.Text
  privacyContent      String?  @db.Text
  termsContent        String?  @db.Text
  kvkkContent         String?  @db.Text
  popularLinks        Json?
  discoverLinks       Json?
  socialLinks         Json?
  navMenuBgColor      String?  @default("#ffffff")
  navMenuFont         String?  @default("sans-serif")
  navMenuMainBold     Boolean? @default(true)
  navMenuTextColor    String?  @default("#111827")
  navMenuFontSize     Int?     @default(14)
  siteBackgroundImage String?
  isWallTransparent   Boolean  @default(false)
  isWallBackgroundRepeat Boolean @default(true)
  homeCategoryIds     Json?
  ribbonColor         String?  @default("#502bb1")
  postitLimit         Int      @default(0)
}

model CalendarCategory {
  id            String              @id @default(cuid())
  name          String
  order         Int                 @default(0)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  globalEntries Json?
  wallEntries   WallCalendarEntry[]
}

model WallCalendarEntry {
  id                 String           @id @default(cuid())
  categoryId         String
  calendarCategoryId String
  date               DateTime         @default(now())
  content            String           @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  calendarCategory   CalendarCategory @relation(fields: [calendarCategoryId], references: [id], onDelete: Cascade)
  category           Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([calendarCategoryId])
}

model PostItLike {
  id        String   @id @default(cuid())
  userId    String
  postItId  String
  createdAt DateTime @default(now())
  postIt    PostIt   @relation(fields: [postItId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postItId])
  @@index([userId])
  @@index([postItId])
}

enum PostItColor {
  YELLOW
  PINK
  BLUE
  GREEN
  ORANGE
  PURPLE
}

enum PostItFont {
  HANDWRITING
  SERIF
  SANS
  MONO
  CURSIVE
}

enum PushpinStyle {
  RED
  BLUE
  GOLD
  GREEN
  PINK
  SILVER
}

enum AdPosition {
  HEADER
  SIDEBAR
  FOOTER
}
