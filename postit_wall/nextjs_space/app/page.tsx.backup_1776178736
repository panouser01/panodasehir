                                  )}
                                </div>
                              </div>
                            </>
                          )
                        ) : (
                          !appearance.hideWallTitle && (
                            <div className="relative flex justify-center w-full mt-6 mb-8 z-10 transition-transform hover:scale-105 duration-300">
