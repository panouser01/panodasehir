                                            color: ottSettings.categoryTitleColor || (appearance.ribbonTextColor === 'transparent' ? 'transparent' : (appearance.ribbonTextColor || (appearance.ribbonColor !== 'none' ? '#ffffff' : '#1f2937'))),
