                                userRole={(session?.user as any)?.role}
                                userId={(session?.user as any)?.id}
                                canEdit={getCanManage(selectedCategory?.id || homeWall?.id!, selectedCategory?.userGroupId || homeWall?.userGroupId)}
                              />
